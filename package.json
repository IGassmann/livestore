{
  "name": "livestore-workspace",
  "private": true,
  "scripts": {
    "docs:build": "scripts/bin/mono docs build",
    "docs:build:api": "scripts/bin/mono docs build --api-docs",
    "docs:build:diagnostics": "bash scripts/bin/package-task docs:build:diagnostics",
    "docs:build:phase:astro": "bash scripts/bin/package-task docs:build:phase:astro",
    "docs:build:phase:diagrams": "bash scripts/bin/package-task docs:build:phase:diagrams",
    "docs:build:phase:snippets": "bash scripts/bin/package-task docs:build:phase:snippets",
    "docs:deploy": "scripts/bin/mono docs deploy",
    "docs:deploy:prod": "scripts/bin/mono docs deploy --prod --build --purge-cdn",
    "docs:deploy:prod:diagnostics": "bash scripts/bin/package-task docs:deploy:prod:diagnostics",
    "docs:deploy:prod:phase:build-deploy": "bash scripts/bin/package-task docs:deploy:prod:phase:build-deploy",
    "docs:deploy:prod:phase:purge": "bash scripts/bin/package-task docs:deploy:prod:phase:purge",
    "docs:deploy:prod:phase:verify": "bash scripts/bin/package-task docs:deploy:prod:phase:verify",
    "docs:dev": "scripts/bin/mono docs dev",
    "docs:search:sync:prod": "bash scripts/bin/package-task docs:search:sync:prod",
    "examples:build:src": "pnpm --filter './examples/**' run build",
    "examples:deploy": "scripts/bin/mono examples deploy",
    "examples:deploy:prod": "scripts/bin/mono examples deploy --prod",
    "examples:install": "pnpm install --frozen-lockfile --dir examples",
    "examples:test": "scripts/bin/mono examples test",
    "examples:validate-links": "scripts/bin/mono examples validate-links",
    "lint:check": "pnpm run lint:check:format && pnpm run lint:check:oxlint && pnpm run lint:check:lockfile",
    "lint:check:format": "oxfmt --check packages tests scripts docs .github",
    "lint:check:lockfile": "pnpm install --lockfile-only --frozen-lockfile",
    "lint:check:madge": "madge --circular --no-spinner examples/*/src packages/*/*/src",
    "lint:check:oxlint": "oxlint --import-plugin --deny-warnings --type-aware --tsconfig tsconfig.dev.json packages tests scripts docs .github",
    "lint:fix": "pnpm run lint:fix:format && pnpm run lint:fix:oxlint",
    "lint:fix:format": "oxfmt packages tests scripts docs .github",
    "lint:fix:oxlint": "oxlint --import-plugin --deny-warnings --fix --type-aware --tsconfig tsconfig.dev.json packages tests scripts docs .github",
    "lint:full": "pnpm run lint:check && pnpm run lint:check:madge && pnpm --dir docs run lint:check:md-imports",
    "lint:full:fix": "pnpm run lint:fix && pnpm run lint:check:madge && pnpm --dir docs run lint:check:md-imports",
    "release:changeset:check-bodies": "bash scripts/bin/package-task release:changeset:check-bodies",
    "release:changeset:check-pr": "bash scripts/bin/package-task release:changeset:check-pr",
    "release:changeset:status": "bash scripts/bin/package-task release:changeset:status",
    "release:changeset:verify-baseline": "bash scripts/bin/package-task release:changeset:verify-baseline",
    "release:changeset:version": "bash scripts/bin/package-task release:changeset:version",
    "release:devtools-artifact:certify-liveness": "bash scripts/bin/package-task release:devtools-artifact:certify-liveness",
    "release:devtools-artifact:certify-liveness:no-install": "bash scripts/bin/package-task release:devtools-artifact:certify-liveness:no-install",
    "release:devtools-artifact:publish": "bash scripts/bin/package-task release:devtools-artifact:publish",
    "release:devtools-artifact:publish:no-install": "bash scripts/bin/package-task release:devtools-artifact:publish:no-install",
    "release:devtools-artifact:repack-dryrun": "bash scripts/bin/package-task release:devtools-artifact:repack-dryrun",
    "release:devtools-artifact:repack-dryrun:no-install": "bash scripts/bin/package-task release:devtools-artifact:repack-dryrun:no-install",
    "release:devtools-artifact:verify": "bash scripts/bin/package-task release:devtools-artifact:verify",
    "release:notes:extract": "scripts/bin/mono release extract-release-notes",
    "release:plan": "bash scripts/bin/package-task release:plan",
    "release:snapshot": "scripts/bin/mono release snapshot",
    "release:snapshot:git-sha": "bash scripts/bin/package-task release:snapshot:git-sha",
    "release:stable:dryrun": "scripts/bin/mono release stable --dry-run --yes",
    "release:stable:publish": "scripts/bin/mono release stable --yes --allow-existing",
    "test:integration:playwright": "pnpm --dir tests/integration run test",
    "test:integration:playwright:devtools": "pnpm --dir tests/integration run test:devtools",
    "test:integration:playwright:misc": "pnpm --dir tests/integration run test:misc",
    "test:integration:playwright:todomvc": "pnpm --dir tests/integration run test:todomvc",
    "test:integration:playwright:upload-trace": "pnpm --dir tests/integration run upload-trace",
    "test:integration:sync-provider": "pnpm --dir tests/sync-provider run test",
    "test:integration:sync-provider:cf-do-rpc-d1": "pnpm --dir tests/sync-provider run test:cf-do-rpc-d1",
    "test:integration:sync-provider:cf-do-rpc-do": "pnpm --dir tests/sync-provider run test:cf-do-rpc-do",
    "test:integration:sync-provider:cf-http-d1": "pnpm --dir tests/sync-provider run test:cf-http-d1",
    "test:integration:sync-provider:cf-http-do": "pnpm --dir tests/sync-provider run test:cf-http-do",
    "test:integration:sync-provider:cf-ws-d1": "pnpm --dir tests/sync-provider run test:cf-ws-d1",
    "test:integration:sync-provider:cf-ws-do": "pnpm --dir tests/sync-provider run test:cf-ws-do",
    "test:integration:sync-provider:mock": "pnpm --dir tests/sync-provider run test:mock",
    "test:integration:wa-sqlite": "pnpm --dir tests/wa-sqlite run test",
    "test:integration:wa-sqlite:build": "pnpm --dir tests/wa-sqlite run build",
    "test:perf": "pnpm --dir tests/perf run test",
    "test:unit": "vitest packages/@livestore packages/@local tests/package-common",
    "ts:build": "tsc --build tsconfig.dev.json",
    "ts:build-watch": "tsc --build tsconfig.dev.json --watch",
    "ts:clean": "tsc --build tsconfig.dev.json --clean",
    "ts:emit": "tsc --build tsconfig.dev.json --noCheck",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "25.3.3",
    "madge": "^8.0.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.39.0",
    "oxlint-tsgolint": "0.18.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "packageManager": "pnpm@11.3.0"
}
