{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "sortImports": {
    "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"]],
    "internalPattern": ["@livestore/", "@local/"]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.pnpm/**",
    "**/.pnpm-store/**",
    "**/dist/**",
    "**/storybook-static/**",
    "**/.turbo/**",
    "**/tmp/**",
    "**/*.gen.ts",
    "**/*.gen.tsx",
    "**/*.generated.ts",
    "**/*.generated.tsx",
    "**/package.json",
    "**/tsconfig.json",
    "**/tsconfig.*.json",
    "tests/integration/node_modules/**",
    "**/*.mdx",
    "docs/.astro/**",
    "docs/.netlify/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ]
}
